{
    "name": "patronbase/omnipay-windcave-hpp",
    "type": "library",
    "description": "Windcave REST API (Hosted Payment Page) payment gateway driver for the Omnipay payment processing library",
    "keywords": [
        "windcave",
        "hosted payment page",
        "rest api",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "hosted",
        "checkout",
        "redirect"
    ],
    "homepage": "https://github.com/PatronBase/omnipay-windcave-hpp",
    "license": "MIT",
    "authors": [
        {
            "name": "Dan Eastmond",
            "email": "dan@firesoft.tech"
        },
        {
            "name": "Aimal Muhammad",
            "email": "aimal.azmi.13@gmail.com"
        },
        {
            "name": "Leith Caldwell",
            "email": "leith@codedruids.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\WindcaveHpp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\WindcaveHpp\\": "src/"
        }
    },
    "require": {
        "omnipay/common": "^3.1",
        "php": "^7.2||^8"
    },
    "require-dev": {
        "omnipay/tests": "^4.2",
        "squizlabs/php_codesniffer": "^3.5",
        "http-interop/http-factory-guzzle": "^1.1"
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs -p --standard=PSR2 src/",
        "fix-style": "phpcbf -p --standard=PSR2 src/"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.2.x-dev"
        }
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
